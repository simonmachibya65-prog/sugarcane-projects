# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sugarcane:password@db:5432/sugarcane_db
SYNC_DATABASE_URL=postgresql://sugarcane:password@db:5432/sugarcane_db

# ── Auth ──────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Redis / Celery ────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── ML Models ─────────────────────────────────────────────────
MODELS_DIR=/app/ml_models
DISEASE_MODEL_NAME=EfficientNetB0
DISEASE_IMG_SIZE=224

# ── App ───────────────────────────────────────────────────────
APP_NAME=SugarCane AI - Morogoro
APP_VERSION=1.0.0
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# ── File Upload ───────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=10
